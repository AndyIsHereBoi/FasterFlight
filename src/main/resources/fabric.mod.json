{
    "schemaVersion": 1,
    "id": "fasterflight",
    "version": "${version}",
    "name": "FasterFlight",
    "description": "Hold a configurable key to multiply your flight speed. The multiplier is adjustable from 1.0x to 25.0x via a ModMenu slider or a manual text box. Works in any gamemode that already allows flying.",
    "authors": [
        "You"
    ],
    "contact": {},
    "license": "MIT",
    "environment": "client",
    "icon": "assets/fasterflight/icon.png",
    "entrypoints": {
        "client": [
            "com.fasterflight.FasterFlightMod"
        ],
        "modmenu": [
            "com.fasterflight.config.ModMenuIntegration"
        ]
    },
    "depends": {
        "fabricloader": ">=0.19.0",
        "fabric-api": "*",
        "minecraft": ">=26.1 <26.2",
        "java": ">=25",
        "cloth-config": ">=26.1"
    },
    "recommends": {
        "modmenu": ">=18.0.0"
    }
}
